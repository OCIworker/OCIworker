#!/usr/bin/env bash
# =============================================================================
# ociworker - Management CLI for OCI Worker
# -----------------------------------------------------------------------------
# Usage:
#   ociworker                  Interactive menu
#   ociworker status           Show status of oci-worker
#   ociworker start            Start services
#   ociworker stop             Stop services
#   ociworker restart          Restart oci-worker
#   ociworker logs             Tail oci-worker logs
#   ociworker config           Modify port / database (rollback on failure)
#   ociworker update           Run install.sh in upgrade mode
#   ociworker backup           Backup db dump + application.yml + keys
#   ociworker restore <file>   Restore from a backup tarball
#   ociworker tg-clean         Clear Telegram bot binding (oci_kv); re-bind in web UI
#   ociworker uninstall        Uninstall everything (asks before each step)
#   ociworker version          Show installer version + jar info
#
# This script never modifies the database schema and never edits files outside
# /opt/oci-worker, /etc/systemd/system/oci-worker*.service.
# =============================================================================

set -euo pipefail

readonly INSTALL_DIR="/opt/oci-worker"
readonly KEYS_DIR="${INSTALL_DIR}/keys"
readonly BACKUP_DIR="${INSTALL_DIR}/backups"
readonly CONFIG_FILE="${INSTALL_DIR}/application.yml"
readonly JAR_NAME="oci-worker.jar"
readonly SERVICE_NAME="oci-worker"
readonly SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
readonly LEGACY_WEBSSH_SERVICE_NAME="oci-webssh"
readonly LEGACY_WEBSSH_SERVICE_FILE="/etc/systemd/system/${LEGACY_WEBSSH_SERVICE_NAME}.service"
readonly REPO="OCIworker/OCIworker"
readonly INSTALLER_RELEASE_TAG="installer-latest"
readonly RAW_BASE="https://raw.githubusercontent.com/${REPO}/main"
# Default Docker MySQL container name used by install.sh. tg-clean can use this
# container when the host does not have a mysql client.
readonly OCI_MYSQL_CONTAINER="${OCI_MYSQL_CONTAINER:-oci-worker-mysql}"

# -----------------------------------------------------------------------------
# Colors / output
# -----------------------------------------------------------------------------
if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    C_RED="$(tput setaf 1)"; C_GREEN="$(tput setaf 2)"; C_YELLOW="$(tput setaf 3)"
    C_BLUE="$(tput setaf 4)"; C_CYAN="$(tput setaf 6)"; C_BOLD="$(tput bold)"; C_RESET="$(tput sgr0)"
else
    C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_CYAN=""; C_BOLD=""; C_RESET=""
fi

info()    { printf "%s[INFO]%s %s\n" "${C_BLUE}" "${C_RESET}" "$*"; }
ok()      { printf "%s[ OK ]%s %s\n" "${C_GREEN}" "${C_RESET}" "$*"; }
warn()    { printf "%s[WARN]%s %s\n" "${C_YELLOW}" "${C_RESET}" "$*" >&2; }
err()     { printf "%s[ERR ]%s %s\n" "${C_RED}" "${C_RESET}" "$*" >&2; }
die()     { err "$*"; exit 1; }
section() { printf "\n%s%s== %s ==%s\n" "${C_BOLD}" "${C_CYAN}" "$*" "${C_RESET}"; }

ask() {
    local prompt="$1" default="${2:-}" reply
    if [ -n "${default}" ]; then printf "%s [%s]: " "${prompt}" "${default}" >&2
    else printf "%s: " "${prompt}" >&2
    fi
    IFS= read -r reply </dev/tty || reply=""
    [ -z "${reply}" ] && printf "%s" "${default}" || printf "%s" "${reply}"
}
ask_password() {
    local prompt="$1" reply
    printf "%s: " "${prompt}" >&2
    IFS= read -r -s reply </dev/tty || reply=""
    printf "\n" >&2
    printf "%s" "${reply}"
}
ask_yes_no() {
    local prompt="$1" default="${2:-Y}" hint reply
    case "${default}" in Y|y) hint="[Y/n]";; N|n) hint="[y/N]";; *) hint="[y/n]";; esac
    while true; do
        printf "%s %s: " "${prompt}" "${hint}" >&2
        IFS= read -r reply </dev/tty || reply=""
        reply="${reply:-${default}}"
        case "${reply}" in
            Y|y|YES|yes|Yes) printf "y"; return 0 ;;
            N|n|NO|no|No)    printf "n"; return 0 ;;
            *) warn "Please enter y or n" ;;
        esac
    done
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then die "Please run as root: sudo ociworker $*"; fi
}

require_installed() {
    if [ ! -f "${CONFIG_FILE}" ] || [ ! -f "${INSTALL_DIR}/${JAR_NAME}" ]; then
        die "OCI Worker installation was not detected. Please run install.sh first."
    fi
}

# Load the same database settings used by the web panel from application.yml.
# This only requires python3; a host mysql client is not required.
_mysql_load_cfg() {
    require_python3 || die "python3 is required to read ${CONFIG_FILE}"
    _MYSQL_JDBC="$(yaml_get spring.datasource.url)" || die "Unable to read spring.datasource.url from ${CONFIG_FILE}"
    _MYSQL_USER="$(yaml_get spring.datasource.username)"
    _MYSQL_PASS="$(yaml_get spring.datasource.password)"
    _MYSQL_HOST="$(echo "${_MYSQL_JDBC}" | sed -n 's#jdbc:mysql://\([^:/]*\).*#\1#p')"
    _MYSQL_PORT="$(echo "${_MYSQL_JDBC}" | sed -n 's#jdbc:mysql://[^:]*:\([0-9]*\)/.*#\1#p')"
    _MYSQL_DB="$(echo "${_MYSQL_JDBC}"   | sed -n 's#jdbc:mysql://[^/]*/\([^?]*\).*#\1#p')"
    [ -n "${_MYSQL_HOST}" ] || _MYSQL_HOST="127.0.0.1"
    [ -n "${_MYSQL_PORT}" ] || _MYSQL_PORT="3306"
    [ -n "${_MYSQL_DB}" ]   || die "Unable to parse the database name from JDBC URL: ${_MYSQL_JDBC}"
    _MYSQL_MODE=""
}

_mysql_host_is_local() {
    case "${_MYSQL_HOST}" in
        localhost|127.0.0.1|::1) return 0 ;;
        *) return 1 ;;
    esac
}

_mysql_docker_available() {
    command -v docker >/dev/null 2>&1 || return 1
    _mysql_host_is_local || return 1
    docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "${OCI_MYSQL_CONTAINER}"
}

_mysql_try_host() {
    command -v mysql >/dev/null 2>&1 || return 1
    local errf; errf="$(mktemp)"
    if MYSQL_PWD="${_MYSQL_PASS}" mysql -h"${_MYSQL_HOST}" -P"${_MYSQL_PORT}" -u"${_MYSQL_USER}" \
            "${_MYSQL_DB}" -N -e "SELECT 1" 2>"${errf}" >/dev/null; then
        rm -f "${errf}"
        return 0
    fi
    rm -f "${errf}"
    return 1
}

_mysql_try_docker() {
    _mysql_docker_available || return 1
    local errf; errf="$(mktemp)"
    if docker exec -i "${OCI_MYSQL_CONTAINER}" env MYSQL_PWD="${_MYSQL_PASS}" \
            mysql -u"${_MYSQL_USER}" "${_MYSQL_DB}" -N -e "SELECT 1" 2>"${errf}" >/dev/null; then
        rm -f "${errf}"
        return 0
    fi
    rm -f "${errf}"
    return 1
}

# Select either the host mysql client or docker exec, matching install.sh's
# default container.
_mysql_ensure_mode() {
    _mysql_load_cfg
    [ -n "${_MYSQL_MODE}" ] && return 0
    if _mysql_try_host; then
        _MYSQL_MODE="host"
        return 0
    fi
    if _mysql_try_docker; then
        _MYSQL_MODE="docker"
        info "The host mysql client is missing or cannot connect directly. Connected through Docker container ${OCI_MYSQL_CONTAINER}."
        return 0
    fi
    err "Unable to connect to the database (${_MYSQL_USER}@${_MYSQL_HOST}:${_MYSQL_PORT}/${_MYSQL_DB})"
    if ! command -v mysql >/dev/null 2>&1; then
        err "The host mysql client is missing and running container ${OCI_MYSQL_CONTAINER} was not detected."
        die "Run: apt install -y default-mysql-client; or start Docker MySQL and retry. Credentials are read from ${CONFIG_FILE}."
    fi
    if _mysql_docker_available; then
        die "Docker container ${OCI_MYSQL_CONTAINER} is running, but the credentials do not match ${CONFIG_FILE}. Check spring.datasource.password."
    fi
    die "Check that spring.datasource in ${CONFIG_FILE} matches the actual MySQL credentials."
}

_mysql_invoke() {
    local sql="$1"
    local numeric="${2:-0}"
    _mysql_ensure_mode
    local errf; errf="$(mktemp)"
    local -a extra=()
    [ "${numeric}" = "1" ] && extra=(-N)
    if [ "${_MYSQL_MODE}" = docker ]; then
        if ! docker exec -i "${OCI_MYSQL_CONTAINER}" env MYSQL_PWD="${_MYSQL_PASS}" \
                mysql -u"${_MYSQL_USER}" "${_MYSQL_DB}" "${extra[@]}" -e "${sql}" 2>"${errf}"; then
            err "Failed to execute SQL through Docker ${OCI_MYSQL_CONTAINER}"
            sed 's/^/  /' "${errf}" >&2
            rm -f "${errf}"
            die "Check the spring.datasource credentials in ${CONFIG_FILE}."
        fi
    else
        if ! MYSQL_PWD="${_MYSQL_PASS}" mysql -h"${_MYSQL_HOST}" -P"${_MYSQL_PORT}" -u"${_MYSQL_USER}" \
                "${_MYSQL_DB}" "${extra[@]}" -e "${sql}" 2>"${errf}"; then
            err "Database execution failed (${_MYSQL_USER}@${_MYSQL_HOST}:${_MYSQL_PORT}/${_MYSQL_DB})"
            sed 's/^/  /' "${errf}" >&2
            rm -f "${errf}"
            die "Check whether ${CONFIG_FILE} and the web panel use the same database."
        fi
    fi
    rm -f "${errf}"
}

_mysql_exec() {
    _mysql_invoke "$1" 0
}

_mysql_scalar() {
    local sql="$1"
    local out errf
    _mysql_ensure_mode
    errf="$(mktemp)"
    if [ "${_MYSQL_MODE}" = docker ]; then
        out="$(docker exec -i "${OCI_MYSQL_CONTAINER}" env MYSQL_PWD="${_MYSQL_PASS}" \
            mysql -u"${_MYSQL_USER}" "${_MYSQL_DB}" -N -e "${sql}" 2>"${errf}")" || {
            err "Query through Docker ${OCI_MYSQL_CONTAINER} failed"
            sed 's/^/  /' "${errf}" >&2
            rm -f "${errf}"
            die "Check the spring.datasource credentials in ${CONFIG_FILE}."
        }
    else
        out="$(MYSQL_PWD="${_MYSQL_PASS}" mysql -h"${_MYSQL_HOST}" -P"${_MYSQL_PORT}" -u"${_MYSQL_USER}" \
            "${_MYSQL_DB}" -N -e "${sql}" 2>"${errf}")" || {
            err "Database query failed (${_MYSQL_USER}@${_MYSQL_HOST}:${_MYSQL_PORT}/${_MYSQL_DB})"
            sed 's/^/  /' "${errf}" >&2
            rm -f "${errf}"
            die "Check whether ${CONFIG_FILE} and the web panel use the same database."
        }
    fi
    rm -f "${errf}"
    echo "${out}" | tail -n1 | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

# -----------------------------------------------------------------------------
# YAML helpers (limited but safe for the application.yml we generate)
# -----------------------------------------------------------------------------
# Both yaml_get and yaml_set use python3 to walk the nested structure based on
# indentation. This avoids brittle awk-based YAML editing and supports nested
# paths like "spring.datasource.url".
require_python3() {
    if ! command -v python3 >/dev/null 2>&1; then
        err "python3 is required: apt install python3 or yum install python3"
        return 2
    fi
}

# yaml_get <dotted.path>     -- echoes the unquoted scalar value, or empty.
# Examples:
#   yaml_get server.port
#   yaml_get web.account
#   yaml_get spring.datasource.url
yaml_get() {
    require_python3 || return 2
    local path="$1"
    python3 - "$path" "$CONFIG_FILE" <<'PYEOF'
import sys, re

path, fpath = sys.argv[1:3]
parts = path.split('.')

with open(fpath, 'r', encoding='utf-8') as f:
    lines = f.readlines()

# Walk the file collecting (indent_level, key) for each non-blank, non-comment line.
def parse_indent_key_value(line):
    s = line.rstrip('\n')
    if not s.strip() or s.lstrip().startswith('#'):
        return None
    indent = len(s) - len(s.lstrip(' '))
    rest = s.strip()
    m = re.match(r'^([A-Za-z0-9_\-]+):\s*(.*)$', rest)
    if not m:
        return None
    return indent, m.group(1), m.group(2)

# Stack of (indent, key) for the current path.
stack = []
for line in lines:
    parsed = parse_indent_key_value(line)
    if parsed is None:
        continue
    indent, key, value = parsed
    while stack and stack[-1][0] >= indent:
        stack.pop()
    stack.append((indent, key))
    cur_path = [k for _, k in stack]
    if cur_path == parts and value != '':
        # Strip surrounding double-quotes if present, unescape \" and \\.
        v = value
        if len(v) >= 2 and v.startswith('"') and v.endswith('"'):
            v = v[1:-1].replace('\\"', '"').replace('\\\\', '\\')
        sys.stdout.write(v)
        sys.exit(0)
PYEOF
}

# yaml_set <dotted.path> <new_value>     -- replaces the scalar at the path.
# The path must already exist (we never insert new keys).
# Value is always written as a YAML double-quoted scalar.
yaml_set() {
    require_python3 || return 2
    local path="$1" val="$2"
    python3 - "$path" "$val" "$CONFIG_FILE" <<'PYEOF'
import sys, re

path, val, fpath = sys.argv[1:4]
parts = path.split('.')

def yaml_escape(s):
    return s.replace('\\', '\\\\').replace('"', '\\"')

with open(fpath, 'r', encoding='utf-8') as f:
    lines = f.readlines()

def parse_indent_key(line):
    s = line.rstrip('\n')
    if not s.strip() or s.lstrip().startswith('#'):
        return None
    indent = len(s) - len(s.lstrip(' '))
    rest = s.strip()
    m = re.match(r'^([A-Za-z0-9_\-]+):\s*(.*)$', rest)
    if not m:
        return None
    return indent, m.group(1), m.group(2)

stack = []
new_lines = []
replaced = False
for line in lines:
    parsed = parse_indent_key(line)
    if parsed is None:
        new_lines.append(line)
        continue
    indent, key, value = parsed
    while stack and stack[-1][0] >= indent:
        stack.pop()
    stack.append((indent, key))
    cur_path = [k for _, k in stack]
    if (not replaced) and cur_path == parts:
        new_lines.append(f'{" " * indent}{key}: "{yaml_escape(val)}"\n')
        replaced = True
    else:
        new_lines.append(line)

if not replaced:
    sys.stderr.write(f'key {path} not found in {fpath}\n')
    sys.exit(2)

with open(fpath, 'w', encoding='utf-8') as f:
    f.writelines(new_lines)
PYEOF
}

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------
cmd_status() {
    require_installed
    section "Service Status"
    systemctl --no-pager --lines=0 status "${SERVICE_NAME}" 2>/dev/null || true
    echo
    section "Basic Information"
    echo "JAR:    $(ls -l "${INSTALL_DIR}/${JAR_NAME}" 2>/dev/null | awk '{print $5,$6,$7,$8}')"
    echo "Config: ${CONFIG_FILE}"
    echo "Port:   $(yaml_get server.port)"
}

cmd_start() {
    require_root start
    require_installed
    systemctl start "${SERVICE_NAME}"
    ok "Started"
}

cmd_stop() {
    require_root stop
    systemctl stop "${SERVICE_NAME}" 2>/dev/null || true
    ok "Stopped"
}

cmd_restart() {
    require_root restart
    require_installed
    systemctl restart "${SERVICE_NAME}"
    ok "Restarted"
}

cmd_logs() {
    require_installed
    journalctl -u "${SERVICE_NAME}" -f --no-pager
}

cmd_config() {
    require_root config
    require_installed
    section "Modify Configuration"

    local cur_port cur_db_url cur_db_user
    cur_port="$(yaml_get server.port)"
    cur_db_url="$(yaml_get spring.datasource.url)"
    cur_db_user="$(yaml_get spring.datasource.username)"

    echo "Current port:     ${cur_port}"
    echo "Current DB URL:   ${cur_db_url}"
    echo "Current DB user:  ${cur_db_user}"
    echo
    echo "[Rule] Each change restarts the service to verify the new configuration."
    echo "       If startup fails, the previous application.yml is restored automatically."
    echo "       Manual backup history is stored at /opt/oci-worker/application.yml.bak.*"
    echo
    echo "[Tip] Change the administrator account/password in the web UI (Settings -> Security)."
    echo

    local choice
    PS3="Select an item to modify (q to quit): "
    select choice in "Web port" "Database change / migration (host/port/database/user/password together)" "Exit"; do
        case "${REPLY}" in
            1)
                local new_port; new_port="$(ask "New Web port" "${cur_port}")"
                if [[ ! "${new_port}" =~ ^[0-9]+$ ]] || [ "${new_port}" -lt 1 ] || [ "${new_port}" -gt 65535 ]; then
                    warn "Invalid port"; continue
                fi
                _backup_and_apply server.port "${new_port}" || true
                ;;
            2)
                _change_database || true
                ;;
            3|q|Q)
                break
                ;;
            *) warn "Please select a menu item number" ;;
        esac
    done
}

_change_database() {
    section "Database Change / Migration"
    cat <<EOF
[i] The database host, port, database name, user, and password are replaced
    as one complete connection profile. The script writes application.yml once,
    then restarts oci-worker to verify it. If startup fails, the previous
    configuration is restored automatically.

[!] If you are migrating data to a new database, such as a panel-managed MySQL:
    run ociworker backup first, import dump.sql into the new database, and only
    then switch the connection. Otherwise, switching to an empty database will
    show the first-time setup page because account, tenant, task, and other
    data still live in the old database.

EOF
    if [ "$(ask_yes_no "Continue changing the database connection?" "Y")" != "y" ]; then
        info "Canceled"
        return 1
    fi

    local cur_url cur_user
    cur_url="$(yaml_get spring.datasource.url)"
    cur_user="$(yaml_get spring.datasource.username)"

    # Parse host / port / dbname out of jdbc:mysql://host:port/db?...
    local cur_host cur_port cur_db
    cur_host="$(echo "${cur_url}"  | sed -n 's#jdbc:mysql://\([^:/]*\).*#\1#p')"
    cur_port="$(echo "${cur_url}"  | sed -n 's#jdbc:mysql://[^:/]*:\([0-9]*\)/.*#\1#p')"
    cur_db="$(echo "${cur_url}"    | sed -n 's#.*/\([^?]*\).*#\1#p')"
    [ -n "${cur_host}" ] || cur_host="127.0.0.1"
    [ -n "${cur_port}" ] || cur_port="3306"
    [ -n "${cur_db}"   ] || cur_db="oci_worker"

    local host port db user pass
    host="$(ask "Database host" "${cur_host}")"
    port="$(ask "Database port" "${cur_port}")"
    db="$(ask   "Database name" "${cur_db}")"
    user="$(ask "Database user" "${cur_user}")"
    pass="$(ask_password "Database password (press Enter to keep the current password)")"

    local new_url
    new_url="jdbc:mysql://${host}:${port}/${db}?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"

    # Atomic backup + multi-write + restart + rollback
    local bak="${CONFIG_FILE}.bak.$(date +%s)"
    cp -p "${CONFIG_FILE}" "${bak}"
    info "Current configuration backed up: ${bak}"

    if ! yaml_set spring.datasource.url "${new_url}"; then
        err "Failed to write URL; restoring"
        cp -p "${bak}" "${CONFIG_FILE}"; return 1
    fi
    if ! yaml_set spring.datasource.username "${user}"; then
        err "Failed to write username; restoring"
        cp -p "${bak}" "${CONFIG_FILE}"; return 1
    fi
    if [ -n "${pass}" ]; then
        if ! yaml_set spring.datasource.password "${pass}"; then
            err "Failed to write password; restoring"
            cp -p "${bak}" "${CONFIG_FILE}"; return 1
        fi
    fi

    info "New configuration written. Restarting service to test the connection..."
    if systemctl restart "${SERVICE_NAME}"; then
        local i
        for i in 1 2 3 4 5; do
            sleep 2
            systemctl is-active --quiet "${SERVICE_NAME}" || { systemctl is-failed --quiet "${SERVICE_NAME}" && break; }
        done
        if systemctl is-active --quiet "${SERVICE_NAME}"; then
            ok "Database connection switched and verified (backup kept: ${bak})"
            return 0
        fi
    fi

    warn "Service startup failed. Restoring the previous configuration..."
    cp -p "${bak}" "${CONFIG_FILE}"
    systemctl restart "${SERVICE_NAME}" || true
    err "Rolled back. Check: journalctl -u ${SERVICE_NAME} -n 50 --no-pager"
    return 1
}

# Backup current yml, apply yaml_set, restart with rollback on failure.
_backup_and_apply() {
    local path="$1" val="$2"
    local bak="${CONFIG_FILE}.bak.$(date +%s)"
    cp -p "${CONFIG_FILE}" "${bak}"
    if ! yaml_set "${path}" "${val}"; then
        err "Could not locate ${path}; changes were reverted"
        cp -p "${bak}" "${CONFIG_FILE}"; rm -f "${bak}"
        return 1
    fi
    info "Wrote ${path}. Restarting service to test..."
    if systemctl restart "${SERVICE_NAME}"; then
        # Wait briefly to confirm it stays up
        local i
        for i in 1 2 3 4 5; do
            sleep 2
            systemctl is-active --quiet "${SERVICE_NAME}" || { systemctl is-failed --quiet "${SERVICE_NAME}" && break; }
        done
        if systemctl is-active --quiet "${SERVICE_NAME}"; then
            ok "Change applied (backup kept: ${bak})"
            return 0
        fi
    fi
    warn "Service startup failed. Rolling back..."
    cp -p "${bak}" "${CONFIG_FILE}"
    systemctl restart "${SERVICE_NAME}" || true
    err "Rolled back to the previous configuration (${bak}). Check: journalctl -u ${SERVICE_NAME} -n 50 --no-pager"
    return 1
}

cmd_update() {
    require_root update
    require_installed
    section "Run Upgrade"
    info "Downloading and running install.sh (main branch first; upgrade mode is auto-detected)..."
    local tmp; tmp="$(mktemp)"
    if curl -fsSL --connect-timeout 15 "${RAW_BASE}/install.sh" -o "${tmp}"; then
        :
    elif curl -fsSL --connect-timeout 15 \
            "https://github.com/${REPO}/releases/download/${INSTALLER_RELEASE_TAG}/install.sh" \
            -o "${tmp}"; then
        :
    else
        rm -f "${tmp}"; die "Failed to download install.sh (main raw and release are both unreachable)"
    fi
    bash "${tmp}"
    rm -f "${tmp}"
}

cmd_backup() {
    require_root backup
    require_installed
    mkdir -p "${BACKUP_DIR}"
    local ts; ts="$(date +%Y%m%d-%H%M%S)"
    local out="${BACKUP_DIR}/oci-worker-backup-${ts}.tar.gz"
    local stage; stage="$(mktemp -d)"
    trap "rm -rf '${stage}'" RETURN

    info "Backing up configuration and keys..."
    cp -a "${CONFIG_FILE}" "${stage}/application.yml"
    [ -d "${KEYS_DIR}" ] && cp -a "${KEYS_DIR}" "${stage}/keys" || true

    info "Backing up database..."
    if ! command -v mysqldump >/dev/null 2>&1; then
        warn "mysqldump is not installed. Skipping database backup (configuration and keys only)."
    else
        local jdbc db_user db_pass host port db
        jdbc="$(yaml_get spring.datasource.url)"
        db_user="$(yaml_get spring.datasource.username)"
        db_pass="$(yaml_get spring.datasource.password)"
        host="$(echo "${jdbc}" | sed -n 's#jdbc:mysql://\([^:/]*\).*#\1#p')"
        port="$(echo "${jdbc}" | sed -n 's#jdbc:mysql://[^:]*:\([0-9]*\).*#\1#p')"
        db="$(echo "${jdbc}"   | sed -n 's#jdbc:mysql://[^/]*/\([^?]*\).*#\1#p')"
        [ -n "${port}" ] || port=3306
        if MYSQL_PWD="${db_pass}" mysqldump -h"${host}" -P"${port}" -u"${db_user}" \
                --single-transaction --routines --triggers \
                --default-character-set=utf8mb4 \
                "${db}" > "${stage}/db.sql" 2>/tmp/mysqldump.err; then
            ok "Database backup completed ($(stat -c%s "${stage}/db.sql" 2>/dev/null || echo "?") bytes)"
        else
            warn "mysqldump failed: $(cat /tmp/mysqldump.err 2>/dev/null)"
            rm -f "${stage}/db.sql"
        fi
    fi

    tar -czf "${out}" -C "${stage}" . || die "Failed to package backup"
    ok "Backup completed: ${out}"
    ls -lh "${out}"
}

cmd_tg_clean() {
    require_root tg-clean
    require_installed
    section "Clear Telegram Binding"
    _mysql_ensure_mode
    if [ "${_MYSQL_MODE}" = docker ]; then
        info "Database: ${_MYSQL_USER}@${OCI_MYSQL_CONTAINER}/${_MYSQL_DB} (Docker; configuration from ${CONFIG_FILE})"
    else
        info "Database: ${_MYSQL_USER}@${_MYSQL_HOST}:${_MYSQL_PORT}/${_MYSQL_DB} (from ${CONFIG_FILE})"
    fi

    local has_token has_chat
    has_token="$(_mysql_scalar "SELECT COUNT(*) FROM oci_kv WHERE type='sys' AND code='tg_bot_token' AND COALESCE(TRIM(value),'') <> '' AND TRIM(value) NOT LIKE '%****%';")"
    has_chat="$(_mysql_scalar "SELECT COUNT(*) FROM oci_kv WHERE type='sys' AND code='tg_chat_id' AND COALESCE(TRIM(value),'') <> '' AND TRIM(value) NOT LIKE '%****%';")"

    if [ "${has_token}" != "1" ] || [ "${has_chat}" != "1" ]; then
        warn "Complete binding was not detected (valid tg_bot_token and tg_chat_id are both required)."
        echo "Current TG-related items in oci_kv:"
        _mysql_exec "SELECT code,
            CASE
              WHEN value IS NULL OR TRIM(value) = '' THEN '(empty)'
              WHEN value LIKE '%****%' THEN '(masked placeholder, not a real token)'
              ELSE CONCAT(LEFT(value, 6), '...(', CHAR_LENGTH(value), ' chars)')
            END AS value_hint
          FROM oci_kv WHERE type='sys' AND code LIKE 'tg_%' ORDER BY code;" || true
        if [ "$(ask_yes_no "Delete all tg_% configuration items anyway, including notification types?" "N")" != "y" ]; then
            info "Canceled."
            return 0
        fi
    else
        echo "This will delete the Bot Token, Chat ID, getUpdates offset, and other tg_% items from the database."
        echo "After clearing, saving notification settings in the panel will not require a TG verification code until Telegram is bound again."
        [ "$(ask_yes_no "Confirm clearing the Telegram binding?" "N")" = "y" ] || { info "Canceled"; return 0; }
    fi
    _mysql_exec "DELETE FROM oci_kv WHERE type='sys' AND code LIKE 'tg_%';"
    ok "Telegram notification settings have been cleared. Please log in to the panel and bind Telegram again."
}

cmd_restore() {
    require_root restore
    require_installed
    local file="${1:-}"
    [ -n "${file}" ] || die "Usage: ociworker restore <backup-file.tar.gz>"
    [ -f "${file}" ] || die "File does not exist: ${file}"

    warn "Restore will overwrite the current configuration, keys, and database. This cannot be undone."
    [ "$(ask_yes_no "Continue?" "N")" = "y" ] || { info "Canceled"; return 0; }

    local stage; stage="$(mktemp -d)"
    trap "rm -rf '${stage}'" RETURN
    tar -xzf "${file}" -C "${stage}" || die "Failed to extract backup"

    systemctl stop "${SERVICE_NAME}" || true

    if [ -f "${stage}/application.yml" ]; then
        cp -p "${CONFIG_FILE}" "${CONFIG_FILE}.bak.before-restore.$(date +%s)" 2>/dev/null || true
        cp "${stage}/application.yml" "${CONFIG_FILE}"
        chmod 600 "${CONFIG_FILE}"
        ok "Restored application.yml"
    fi
    if [ -d "${stage}/keys" ]; then
        rm -rf "${KEYS_DIR}"
        cp -a "${stage}/keys" "${KEYS_DIR}"
        ok "Restored keys/"
    fi
    if [ -f "${stage}/db.sql" ]; then
        local jdbc db_user db_pass host port db
        jdbc="$(yaml_get spring.datasource.url)"
        db_user="$(yaml_get spring.datasource.username)"
        db_pass="$(yaml_get spring.datasource.password)"
        host="$(echo "${jdbc}" | sed -n 's#jdbc:mysql://\([^:/]*\).*#\1#p')"
        port="$(echo "${jdbc}" | sed -n 's#jdbc:mysql://[^:]*:\([0-9]*\).*#\1#p')"
        db="$(echo "${jdbc}"   | sed -n 's#jdbc:mysql://[^/]*/\([^?]*\).*#\1#p')"
        [ -n "${port}" ] || port=3306
        info "Restoring database ${db}@${host}:${port}..."
        if MYSQL_PWD="${db_pass}" mysql -h"${host}" -P"${port}" -u"${db_user}" "${db}" < "${stage}/db.sql"; then
            ok "Database restored"
        else
            warn "Database restore failed. Please inspect db.sql manually."
            cp "${stage}/db.sql" "/tmp/oci-worker-restore-db.sql"
            warn "Saved to /tmp/oci-worker-restore-db.sql"
        fi
    fi

    systemctl start "${SERVICE_NAME}"
    ok "Restore completed"
}

cmd_uninstall() {
    require_root uninstall
    section "Uninstall OCI Worker"
    [ "$(ask_yes_no "Are you sure you want to uninstall OCI Worker?" "N")" = "y" ] || { info "Canceled"; return 0; }

    info "Stopping services..."
    systemctl stop "${SERVICE_NAME}" 2>/dev/null || true
    systemctl stop "${LEGACY_WEBSSH_SERVICE_NAME}" 2>/dev/null || true
    systemctl disable "${SERVICE_NAME}" 2>/dev/null || true
    systemctl disable "${LEGACY_WEBSSH_SERVICE_NAME}" 2>/dev/null || true
    rm -f "${SERVICE_FILE}" "${LEGACY_WEBSSH_SERVICE_FILE}"
    rm -f "${INSTALL_DIR}/oci-webssh"
    systemctl daemon-reload

    if [ "$(ask_yes_no "Delete ${INSTALL_DIR}, including application.yml, keys, JAR, and backups?" "N")" = "y" ]; then
        rm -rf "${INSTALL_DIR}"
        ok "Deleted ${INSTALL_DIR}"
    else
        info "Kept ${INSTALL_DIR}"
    fi

    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "oci-worker-mysql"; then
        if [ "$(ask_yes_no "Delete Docker MySQL container oci-worker-mysql?" "N")" = "y" ]; then
            docker rm -f oci-worker-mysql >/dev/null 2>&1 || true
            ok "MySQL container deleted"
            if [ "$(ask_yes_no "Also delete MySQL data directory /opt/oci-worker/data/mysql?" "N")" = "y" ]; then
                rm -rf /opt/oci-worker/data/mysql
                ok "Data directory deleted"
            fi
        fi
    fi

    if [ "$(ask_yes_no "Delete the ociworker management script?" "N")" = "y" ]; then
        rm -f /usr/local/bin/ociworker
        ok "Deleted"
    fi

    ok "Uninstall completed"
}

cmd_version() {
    section "Version Information"
    [ -f "${INSTALL_DIR}/${JAR_NAME}" ] && ls -lh "${INSTALL_DIR}/${JAR_NAME}" || echo "JAR is not installed"
    if command -v java >/dev/null 2>&1; then java -version 2>&1 | head -n 1; fi
}

# -----------------------------------------------------------------------------
# Interactive menu
# -----------------------------------------------------------------------------
menu() {
    # In interactive menu mode, individual command failures must not exit
    # the whole script. Use `|| true` on every command invocation.
    while true; do
        section "OCI Worker Management"
        cat <<EOF
  1) Status           2) Start        3) Stop         4) Restart
  5) Live logs        6) Configure (with rollback)
  7) Backup           8) Restore
  9) Upgrade latest  10) Version
 11) Clear TG binding 12) Uninstall
  0) Exit
EOF
        printf "> " >&2
        local c; IFS= read -r c </dev/tty || break
        case "${c}" in
            1)  cmd_status         || true ;;
            2)  cmd_start          || true ;;
            3)  cmd_stop           || true ;;
            4)  cmd_restart        || true ;;
            5)  cmd_logs           || true ;;
            6)  cmd_config         || true ;;
            7)  cmd_backup         || true ;;
            8)
                local f; f="$(ask "Backup file path")"
                cmd_restore "${f}" || true
                ;;
            9)  cmd_update         || true ;;
            10) cmd_version        || true ;;
            11) cmd_tg_clean       || true ;;
            12) cmd_uninstall      || true ;;
            0|q|Q|exit) info "Goodbye"; break ;;
            *) warn "Invalid option" ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Dispatch
# -----------------------------------------------------------------------------
usage() {
    sed -n '2,30p' "$0"
}

main() {
    if [ $# -eq 0 ]; then
        menu
        return
    fi
    local sub="$1"; shift || true
    case "${sub}" in
        status)        cmd_status ;;
        start)         cmd_start ;;
        stop)          cmd_stop ;;
        restart)       cmd_restart ;;
        logs)          cmd_logs ;;
        config)        cmd_config ;;
        update)        cmd_update ;;
        backup)        cmd_backup ;;
        restore)       cmd_restore "$@" ;;
        tg-clean)      cmd_tg_clean ;;
        uninstall)     cmd_uninstall ;;
        version)       cmd_version ;;
        menu)          menu ;;
        -h|--help|help) usage ;;
        *) err "Unknown command: ${sub}"; usage; exit 1 ;;
    esac
}

main "$@"
